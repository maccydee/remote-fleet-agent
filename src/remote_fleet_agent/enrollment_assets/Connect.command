#!/bin/sh
# Generated locally for one device. Contains a short-lived enrollment secret.
set -eu
umask 077
PATH=/usr/bin:/bin:/usr/sbin:/sbin
export PATH
[ "$(uname -s)" = Darwin ] || { echo 'This connection kit is for macOS.'; exit 1; }
[ "$(id -u)" != 0 ] || { echo 'Double-click this file as the Mac user; do not run the entire script with sudo.'; exit 1; }
RF_USER=$(id -un)
RF_HOME=$HOME
RF_TMP=$(mktemp -d "${TMPDIR:-/tmp}/remote-fleet.XXXXXXXX")
trap 'rm -rf "$RF_TMP"' EXIT HUP INT TERM
printf '%s\n' 'Remote Fleet: connect this Mac to the approved engineer.' 'An administrator password may be requested. No Python is installed by this step.'
# Enrollment metadata and certificate are generated by the engineer controller.
@@METADATA@@
sudo -v
[ ! -L "$RF_HOME/.ssh" ] || { echo 'The SSH folder is a symbolic link. Setup stopped.'; exit 1; }
mkdir -p "$RF_HOME/.ssh"
[ "$(stat -f %u "$RF_HOME/.ssh")" = "$(id -u)" ] || exit 1
chmod -N "$RF_HOME/.ssh"
chmod 700 "$RF_HOME/.ssh"
RF_KEYS="$RF_HOME/.ssh/authorized_keys"
[ ! -L "$RF_KEYS" ] || { echo 'The SSH key file is a symbolic link. Setup stopped.'; exit 1; }
if [ -e "$RF_KEYS" ]; then
    [ -f "$RF_KEYS" ] && [ "$(stat -f %u "$RF_KEYS")" = "$(id -u)" ] && [ "$(stat -f %l "$RF_KEYS")" = 1 ] || exit 1
fi
touch "$RF_KEYS"
chmod -N "$RF_KEYS"
chmod 600 "$RF_KEYS"
# Source-bound access preserves existing keys and does not enable password access.
if ! grep -Fqx "$RF_KEY_LINE" "$RF_KEYS"; then
    printf '\n%s\n' "$RF_KEY_LINE" >> "$RF_KEYS"
fi
if dscl . -read /Groups/com.apple.access_ssh >/dev/null 2>&1; then
    sudo dseditgroup -o edit -a "$RF_USER" -t user com.apple.access_ssh
fi
if ! sudo systemsetup -setremotelogin on; then
    printf '%s\n' 'macOS requires approval: turn on Remote Login in General > Sharing, allowing your current account.'
    open 'x-apple.systempreferences:com.apple.Sharing-Settings.extension'
fi
# Apple may require a separate Full Disk Access / Remote Login consent. Do not bypass it.
RF_ATTEMPT=0
until nc -z -w 1 127.0.0.1 22 >/dev/null 2>&1; do
    RF_ATTEMPT=$((RF_ATTEMPT+1))
    [ "$RF_ATTEMPT" -lt 120 ] || { echo 'Remote Login is not available. Approve it in System Settings and run this file again before the kit expires.'; exit 1; }
    sleep 2
done
[ -f /etc/ssh/ssh_host_ed25519_key.pub ] || sudo ssh-keygen -A
RF_HOST_KEY=$(cat /etc/ssh/ssh_host_ed25519_key.pub)
plutil -create xml1 "$RF_TMP/receipt.plist"
plutil -insert kit -string "$RF_KIT" "$RF_TMP/receipt.plist"
plutil -insert token -string "$RF_TOKEN" "$RF_TMP/receipt.plist"
plutil -insert username -string "$RF_USER" "$RF_TMP/receipt.plist"
plutil -insert host_key -string "$RF_HOST_KEY" "$RF_TMP/receipt.plist"
plutil -convert json -o "$RF_TMP/receipt.json" "$RF_TMP/receipt.plist"
curl --silent --show-error --fail --noproxy '*' --connect-timeout 10 --max-time 30 --cacert "$RF_TMP/controller.pem" -H 'Content-Type: application/json' --data-binary "@$RF_TMP/receipt.json" "$RF_URL" > "$RF_TMP/response.json"
printf '%s\n' 'Pairing received. The engineer dashboard will verify SSH and display the connection result.' 'You can close this window. Delete this kit after pairing; it contains a short-lived secret.'
